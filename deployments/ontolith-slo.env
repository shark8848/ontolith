# Ontolith SLO history checker environment
# Installed to: ~/.config/ontolith/ontolith-slo.env

# Management monitoring endpoint used by the sample collector.
# ONTOLITH_MANAGEMENT_MONITORING_URL=http://127.0.0.1:9091/admin/monitoring
# SLO history state directory (samples.jsonl / reports.jsonl / alerts.jsonl)
# ONTOLITH_SLO_STATE_DIR=${HOME}/.local/state/ontolith/slo

# Window thresholds (check-slo-window-history.sh)
# ONTOLITH_SLO_MIN_SUCCESS_PERCENT=99
# ONTOLITH_SLO_P95_MAX_LATENCY_MS=250
# ONTOLITH_SLO_MAX_CONSECUTIVE_FAILURES=3
# ONTOLITH_SLO_LATENCY_SPIKE_FACTOR=2.0
