[Unit]
Description=Ontolith SLO probe sample collector (management runtime_probe)
Documentation=file:///home/ontolith/docs/L5-management-platform-slo.md
After=ontolith-management-server.service

[Service]
Type=oneshot
WorkingDirectory=/home/ontolith
EnvironmentFile=-%h/.config/ontolith/ontolith-slo.env
ExecStart=/home/ontolith/scripts/collect-slo-sample.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ontolith-slo-collect
