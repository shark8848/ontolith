[Unit]
Description=Ontolith daily SLO window check (24h success% / p95 / alert policy)
Documentation=file:///home/ontolith/docs/L5-management-platform-slo.md
After=ontolith-slo-collect.service

[Service]
Type=oneshot
WorkingDirectory=/home/ontolith
EnvironmentFile=-%h/.config/ontolith/ontolith-slo.env
ExecStart=/home/ontolith/scripts/check-slo-window-history.sh --window-hours 24

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ontolith-slo-daily
