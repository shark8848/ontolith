# User-level Ontolith management server environment
# Installed to: ~/.config/ontolith/ontolith-management.env

ONTOLITH_MANAGEMENT_BIND=127.0.0.1:9091
ONTOLITH_BIND=127.0.0.1:8090
ONTOLITH_STORAGE=memory
ONTOLITH_DATA_DIR=/home/ontolith/data
ONTOLITH_AUTH_MODE=disabled
# ONTOLITH_API_KEY=change-me
# ONTOLITH_MANAGEMENT_READ_KEY=read-key
# ONTOLITH_MANAGEMENT_WRITE_KEY=write-key
# ONTOLITH_MANAGEMENT_PROBE_TIMEOUT_MS=300

# In-process TLS termination (rustls). Required when binding non-loopback (R2 gate):
# non-loopback binds refuse to start without both variables below.
# ONTOLITH_TLS_CERT=/etc/ontolith/tls/ontolith.crt.pem
# ONTOLITH_TLS_KEY=/etc/ontolith/tls/ontolith.key.pem

# Windowed SLO checker thresholds (scripts/check-management-slo-window.sh)
# ONTOLITH_MANAGEMENT_SLO_WINDOW_SAMPLES=12
# ONTOLITH_MANAGEMENT_SLO_WINDOW_INTERVAL_SEC=5
# ONTOLITH_MANAGEMENT_SLO_MIN_SUCCESS_PERCENT=99
# ONTOLITH_MANAGEMENT_SLO_P95_MAX_LATENCY_MS=250
