# Ontolith console configuration (copy to .env and fill in)
CONSOLE_BIND=127.0.0.1:8890
# Static dir served by server.js: dist/ (Vite build) when present, else src/
# CONSOLE_STATIC_DIR=dist
ONTOLITH_GATEWAY_URL=http://127.0.0.1:8080
ONTOLITH_MANAGEMENT_URL=http://127.0.0.1:9091
ONTOLITH_GRPC_URL=http://127.0.0.1:50051
# Required: credentials for ontolith AUTH_MODE=enforced
ONTOLITH_API_KEY=change-me
ONTOLITH_TENANT=prod
ONTOLITH_USER=console
# Optional dashboard auto-refresh interval (ms)
CONSOLE_REFRESH_MS=5000
# Optional: history sampler window (points)
CONSOLE_HISTORY_POINTS=120
# Optional: upstream proxy timeout (ms) for /api/gw|/api/mg calls
# CONSOLE_PROXY_TIMEOUT_MS=60000
# Optional: console access token (enables Bearer auth on all console routes)
# CONSOLE_AUTH_TOKEN=change-me
# Optional: TLS for the console itself (remote access via reverse proxy)
# CONSOLE_TLS_CERT=/path/to/cert.pem
# CONSOLE_TLS_KEY=/path/to/key.pem
# Multi-cluster: create clusters.json (see clusters.example.json); env vars above
# then apply to the single "default" cluster only.
