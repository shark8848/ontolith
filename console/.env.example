# Ontolith console configuration (copy to .env and fill in)
CONSOLE_BIND=127.0.0.1:8890
ONTOLITH_GATEWAY_URL=http://127.0.0.1:8080
ONTOLITH_MANAGEMENT_URL=http://127.0.0.1:9091
# Required: credentials for ontolith AUTH_MODE=enforced
ONTOLITH_API_KEY=change-me
ONTOLITH_TENANT=prod
ONTOLITH_USER=console
# Optional refresh interval for dashboard auto-reload (ms)
CONSOLE_REFRESH_MS=5000
